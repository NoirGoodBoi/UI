local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

local NoirUI = {}

function NoirUI:CreateWindow(settings)
    local old = game.CoreGui:FindFirstChild("NoirUI")
    if old then old:Destroy() end

    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    ScreenGui.Name = "NoirUI"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local ACCENT = settings.Accent or Color3.fromRGB(170,85,255)
    local BACKGROUND_SETTING = settings.Background or "color"
    local BACKGROUND_IMAGE = settings.BackgroundImage or ""
    
    -- Blur effect
    local Blur = Instance.new("BlurEffect", game.Lighting)
    Blur.Size = 12
    
    -- Main Window
    local Main = Instance.new("Frame", ScreenGui)
    Main.Size = UDim2.new(0,300,0,200)
    Main.Position = UDim2.new(0.5,-150,0.5,-100)
    Main.BackgroundColor3 = Color3.fromRGB(10,10,10)
    Main.BackgroundTransparency = 0
    Main.ClipsDescendants = true
    Instance.new("UICorner", Main)
    
    -- Background image
    if BACKGROUND_SETTING == "image" and BACKGROUND_IMAGE ~= "" then
        local bgImage = Instance.new("ImageLabel", Main)
        bgImage.Size = UDim2.new(1,0,1,0)
        bgImage.BackgroundTransparency = 1
        bgImage.Image = "rbxassetid://" .. tostring(BACKGROUND_IMAGE):gsub("%D", "")
        bgImage.ImageTransparency = 0.85
        Instance.new("UICorner", bgImage).CornerRadius = UDim.new(0,8)
    end
    
    local Stroke = Instance.new("UIStroke", Main)
    Stroke.Thickness = 2
    local Glow = Instance.new("UIStroke", Main)
    Glow.Thickness = 6
    Glow.Transparency = 0.7

    -- Rainbow border effect
    local rainbowActive = true
    task.spawn(function()
        while rainbowActive and Main and Main.Parent do
            for i = 0,1,0.02 do
                if not rainbowActive or not Main or not Main.Parent then break end
                local c = Color3.fromHSV(i,1,1)
                Stroke.Color = c
                Glow.Color = c
                task.wait(0.02)
            end
        end
    end)

    -- Header
    local Header = Instance.new("Frame", Main)
    Header.Size = UDim2.new(1,0,0,45)
    Header.BackgroundTransparency = 1
    
    local Title = Instance.new("TextLabel", Header)
    Title.Size = UDim2.new(1,-80,1,0)
    Title.Position = UDim2.new(0,5,0,0)
    Title.BackgroundTransparency = 1
    Title.Text = settings.Name or "Noir UI"
    Title.TextColor3 = Color3.new(1,1,1)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18

    if settings.HeaderIcon then
        local HIcon = Instance.new("ImageLabel", Header)
        HIcon.Size = UDim2.new(0,25,0,25)
        HIcon.Position = UDim2.new(0,10,0.5,-12.5)
        HIcon.BackgroundTransparency = 1
        HIcon.Image = "rbxassetid://" .. tostring(settings.HeaderIcon):gsub("%D", "")
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UIPadding", Title).PaddingLeft = UDim.new(0, 45)
    else
        Title.TextXAlignment = Enum.TextXAlignment.Center
    end

    -- Minimize button
    local MinBtn = Instance.new("TextButton", Header)
    MinBtn.Size = UDim2.new(0,30,0,30)
    MinBtn.Position = UDim2.new(1,-70,0,7.5)
    MinBtn.Text = "−"
    MinBtn.TextColor3 = Color3.fromRGB(200,200,200)
    MinBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.TextSize = 20
    Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(1,0)
    
    -- Close button
    local CloseBtn = Instance.new("TextButton", Header)
    CloseBtn.Size = UDim2.new(0,30,0,30)
    CloseBtn.Position = UDim2.new(1,-35,0,7.5)
    CloseBtn.Text = "✕"
    CloseBtn.TextColor3 = Color3.fromRGB(200,200,200)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 16
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1,0)
    
    -- Container (ScrollingFrame)
    local Container = Instance.new("ScrollingFrame", Main)
    Container.Size = UDim2.new(1,-10,1,-55)
    Container.Position = UDim2.new(0,5,0,50)
    Container.BackgroundTransparency = 1
    Container.ScrollBarThickness = 2
    Container.BorderSizePixel = 0
    
    local Layout = Instance.new("UIListLayout", Container)
    Layout.Padding = UDim.new(0,8)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    -- Biến trạng thái minimize
    local isMinimized = false
    local fullHeight = 200
    
    -- Hàm cập nhật chiều cao UI
    local function updateUISize()
        task.wait(0.05)
        if not Main or not Main.Parent then return end
        local contentHeight = Layout.AbsoluteContentSize.Y
        local newHeight = math.min(contentHeight + 65, 340)
        newHeight = math.max(newHeight, 150)
        fullHeight = newHeight
        
        if not isMinimized then
            local targetSize = UDim2.new(0,300,0,newHeight)
            Container.CanvasSize = UDim2.new(0,0,0,contentHeight + 10)
            TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                Size = targetSize
            }):Play()
            
            task.wait(0.1)
            Main.Position = UDim2.new(0.5, -Main.Size.X.Offset/2, 0.5, -Main.Size.Y.Offset/2)
        end
    end
    
    -- Minimize/Maximize functions
    local function Minimize()
        if isMinimized then return end
        isMinimized = true
        TweenService:Create(Blur, TweenInfo.new(0.2), {Size = 0}):Play()
        TweenService:Create(Container, TweenInfo.new(0.25), {Size = UDim2.new(1,-10,0,0)}):Play()
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0,300,0,45)}):Play()
        MinBtn.Text = "□"
    end
    
    local function Maximize()
        if not isMinimized then return end
        isMinimized = false
        TweenService:Create(Blur, TweenInfo.new(0.2), {Size = 12}):Play()
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0,300,0,fullHeight)}):Play()
        TweenService:Create(Container, TweenInfo.new(0.25), {Size = UDim2.new(1,-10,1,-55)}):Play()
        MinBtn.Text = "−"
        task.wait(0.3)
        Container.CanvasSize = UDim2.new(0,0,0,Layout.AbsoluteContentSize.Y + 10)
    end
    
    MinBtn.MouseButton1Click:Connect(function()
        if isMinimized then Maximize() else Minimize() end
    end)
    
    CloseBtn.MouseButton1Click:Connect(function()
        Main.Visible = false
        TweenService:Create(Blur, TweenInfo.new(0.2), {Size = 0}):Play()
    end)

    -- Drag system
    local dragMain = false
    local dragMainStart = nil
    local dragMainPos = nil
    
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragMain = true
            dragMainStart = input.Position
            dragMainPos = Main.Position
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if dragMain and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragMainStart
            Main.Position = UDim2.new(dragMainPos.X.Scale, dragMainPos.X.Offset + delta.X, dragMainPos.Y.Scale, dragMainPos.Y.Offset + delta.Y)
        end
    end)
    
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragMain = false
        end
    end)

    -- Notify System
    local NotifyHolder = ScreenGui:FindFirstChild("NotifyHolder") or Instance.new("Frame", ScreenGui)
    NotifyHolder.Name = "NotifyHolder"
    NotifyHolder.Size = UDim2.new(0,300,1,-20)
    NotifyHolder.Position = UDim2.new(1,-310,0,10)
    NotifyHolder.BackgroundTransparency = 1
    NotifyHolder.ClipsDescendants = false
    
    local NList = NotifyHolder:FindFirstChild("UIListLayout") or Instance.new("UIListLayout", NotifyHolder)
    NList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NList.Padding = UDim.new(0,10)
    NList.SortOrder = Enum.SortOrder.LayoutOrder

    local activeNotifies = {}
    
    function NoirUI:Notify(title, text, duration)
        duration = duration or 4
        
        local n = Instance.new("Frame", NotifyHolder)
        n.Size = UDim2.new(1,0,0,70)
        n.BackgroundColor3 = Color3.fromRGB(20,20,20)
        n.BackgroundTransparency = 0.3
        n.ClipsDescendants = true
        Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
        
        local ns = Instance.new("UIStroke", n)
        ns.Color = ACCENT
        ns.Thickness = 1.5
        ns.Transparency = 1
        
        local nt = Instance.new("TextLabel", n)
        nt.Size = UDim2.new(1,-15,0,25)
        nt.Position = UDim2.new(0,15,0,5)
        nt.Text = title
        nt.TextColor3 = Color3.new(1,1,1)
        nt.Font = Enum.Font.GothamBold
        nt.TextSize = 14
        nt.BackgroundTransparency = 1
        nt.TextXAlignment = Enum.TextXAlignment.Left
        
        local nc = Instance.new("TextLabel", n)
        nc.Size = UDim2.new(1,-15,0,30)
        nc.Position = UDim2.new(0,15,0,32)
        nc.Text = text
        nc.TextColor3 = Color3.fromRGB(200,200,200)
        nc.Font = Enum.Font.Gotham
        nc.TextSize = 12
        nc.BackgroundTransparency = 1
        nc.TextXAlignment = Enum.TextXAlignment.Left
        nc.TextWrapped = true
        nc.TextYAlignment = Enum.TextYAlignment.Top
        
        local progress = Instance.new("Frame", n)
        progress.Size = UDim2.new(1,0,0,2)
        progress.Position = UDim2.new(0,0,1,-2)
        progress.BackgroundColor3 = ACCENT
        progress.BackgroundTransparency = 0.3
        
        table.insert(activeNotifies, n)
        
        local function updatePositions()
            for i, notify in ipairs(activeNotifies) do
                local targetPos = UDim2.new(0,0,0,(i-1) * 80)
                TweenService:Create(notify, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
            end
        end
        
        n.Position = UDim2.new(0,100,0,0)
        n.BackgroundTransparency = 1
        TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0,0,0,(#activeNotifies-1) * 80),
            BackgroundTransparency = 0.3
        }):Play()
        TweenService:Create(ns, TweenInfo.new(0.3), {Transparency = 0}):Play()
        
        local progressTween = TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0,0,0,2)
        })
        progressTween:Play()
        
        task.delay(duration, function()
            if n and n.Parent then
                for i, v in ipairs(activeNotifies) do
                    if v == n then
                        table.remove(activeNotifies, i)
                        break
                    end
                end
                
                TweenService:Create(n, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
                    Position = UDim2.new(0,-100,0,0),
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(ns, TweenInfo.new(0.15), {Transparency = 1}):Play()
                
                task.wait(0.25)
                if n and n.Parent then n:Destroy() end
                updatePositions()
            end
        end)
        
        return n
    end

    -- ============================================
    -- REMADE SLIDER
    -- ============================================
    function NoirUI:CreateSlider(options)
        elementCount = elementCount + 1
        local min = options.Min or 0
        local max = options.Max or 100
        local value = options.Default or min
        local decimal = options.Decimal or 0
        
        local sliderFrame = Instance.new("Frame", Container)
        sliderFrame.Size = UDim2.new(1,0,0,70)
        sliderFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
        sliderFrame.LayoutOrder = elementCount
        Instance.new("UICorner", sliderFrame).CornerRadius = UDim.new(0,8)
        
        -- Title
        local title = Instance.new("TextLabel", sliderFrame)
        title.Size = UDim2.new(1,-15,0,25)
        title.Position = UDim2.new(0,10,0,5)
        title.Text = options.Name or "Slider"
        title.TextColor3 = Color3.fromRGB(220,220,220)
        title.Font = Enum.Font.GothamSemibold
        title.TextSize = 13
        title.BackgroundTransparency = 1
        title.TextXAlignment = Enum.TextXAlignment.Left
        
        -- Value display
        local valueDisplay = Instance.new("TextLabel", sliderFrame)
        valueDisplay.Size = UDim2.new(0,50,0,25)
        valueDisplay.Position = UDim2.new(1,-60,0,5)
        valueDisplay.Text = tostring(value)
        valueDisplay.TextColor3 = ACCENT
        valueDisplay.Font = Enum.Font.GothamBold
        valueDisplay.TextSize = 13
        valueDisplay.BackgroundTransparency = 1
        valueDisplay.TextXAlignment = Enum.TextXAlignment.Right
        
        -- Slider background
        local sliderBack = Instance.new("Frame", sliderFrame)
        sliderBack.Size = UDim2.new(1,-20,0,6)
        sliderBack.Position = UDim2.new(0,10,0,45)
        sliderBack.BackgroundColor3 = Color3.fromRGB(50,50,50)
        Instance.new("UICorner", sliderBack).CornerRadius = UDim.new(1,0)
        
        -- Slider fill
        local sliderFill = Instance.new("Frame", sliderBack)
        sliderFill.Size = UDim2.new((value - min)/(max - min),0,1,0)
        sliderFill.BackgroundColor3 = ACCENT
        Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1,0)
        
        -- Slider button
        local sliderBtn = Instance.new("TextButton", sliderBack)
        sliderBtn.Size = UDim2.new(0,16,0,16)
        sliderBtn.Position = UDim2.new((value - min)/(max - min), -8, 0.5, -8)
        sliderBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
        sliderBtn.Text = ""
        sliderBtn.AutoButtonColor = false
        Instance.new("UICorner", sliderBtn).CornerRadius = UDim.new(1,0)
        
        -- Shadow for button
        local shadow = Instance.new("UIStroke", sliderBtn)
        shadow.Thickness = 2
        shadow.Color = ACCENT
        
        local dragging = false
        
        local function updateValue(input)
            local relativePos = math.clamp((input.Position.X - sliderBack.AbsolutePosition.X) / sliderBack.AbsoluteSize.X, 0, 1)
            local newValue = min + (max - min) * relativePos
            if decimal == 0 then
                newValue = math.floor(newValue)
            else
                newValue = math.round(newValue * (10^decimal)) / (10^decimal)
            end
            value = newValue
            
            sliderFill.Size = UDim2.new(relativePos,0,1,0)
            sliderBtn.Position = UDim2.new(relativePos, -8, 0.5, -8)
            valueDisplay.Text = tostring(value)
            title.Text = (options.Name or "Slider") .. ": " .. value
            
            if options.Callback then options.Callback(value) end
        end
        
        sliderBtn.MouseButton1Click:Connect(function(input)
            dragging = true
        end)
        
        sliderBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
            end
        end)
        
        sliderBack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateValue(input)
            end
        end)
        
        UIS.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateValue(input)
            end
        end)
        
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        updateUISize()
        
        return {
            SetValue = function(v)
                v = math.clamp(v, min, max)
                local percent = (v - min)/(max - min)
                sliderFill.Size = UDim2.new(percent,0,1,0)
                sliderBtn.Position = UDim2.new(percent, -8, 0.5, -8)
                valueDisplay.Text = tostring(v)
                title.Text = (options.Name or "Slider") .. ": " .. v
                if options.Callback then options.Callback(v) end
            end,
            GetValue = function() return value end
        }
    end

    -- ============================================
    -- REMADE TEXTBOX
    -- ============================================
    function NoirUI:CreateTextBox(options)
        elementCount = elementCount + 1
        
        local boxFrame = Instance.new("Frame", Container)
        boxFrame.Size = UDim2.new(1,0,0,55)
        boxFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
        boxFrame.LayoutOrder = elementCount
        Instance.new("UICorner", boxFrame).CornerRadius = UDim.new(0,8)
        
        -- Title
        local title = Instance.new("TextLabel", boxFrame)
        title.Size = UDim2.new(1,-15,0,20)
        title.Position = UDim2.new(0,10,0,5)
        title.Text = options.Name or "Text Input"
        title.TextColor3 = Color3.fromRGB(220,220,220)
        title.Font = Enum.Font.GothamSemibold
        title.TextSize = 12
        title.BackgroundTransparency = 1
        title.TextXAlignment = Enum.TextXAlignment.Left
        
        -- TextBox chính
        local box = Instance.new("TextBox", boxFrame)
        box.Size = UDim2.new(1,-20,0,30)
        box.Position = UDim2.new(0,10,0,22)
        box.BackgroundColor3 = Color3.fromRGB(35,35,35)
        box.TextColor3 = Color3.fromRGB(255,255,255)
        box.PlaceholderText = options.Placeholder or "Nhập nội dung..."
        box.PlaceholderColor3 = Color3.fromRGB(120,120,120)
        box.Font = Enum.Font.Gotham
        box.TextSize = 13
        box.Text = options.Default or ""
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.ClearTextOnFocus = false
        Instance.new("UICorner", box).CornerRadius = UDim.new(0,6)
        Instance.new("UIPadding", box).PaddingLeft = UDim.new(0,10)
        
        -- Border animation
        local border = Instance.new("UIStroke", box)
        border.Thickness = 1
        border.Color = Color3.fromRGB(50,50,50)
        
        box.Focused:Connect(function()
            TweenService:Create(border, TweenInfo.new(0.15), {Color = ACCENT, Thickness = 2}):Play()
            TweenService:Create(box, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40,40,40)}):Play()
        end)
        
        box.FocusLost:Connect(function(enterPressed)
            TweenService:Create(border, TweenInfo.new(0.15), {Color = Color3.fromRGB(50,50,50), Thickness = 1}):Play()
            TweenService:Create(box, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35,35,35)}):Play()
            if options.Callback then options.Callback(box.Text) end
        end)
        
        updateUISize()
        
        return {
            SetText = function(text) box.Text = text end,
            GetText = function() return box.Text end,
            Clear = function() box.Text = "" end
        }
    end

    -- ============================================
    -- REMADE DROPDOWN
    -- ============================================
    function NoirUI:CreateDropdown(options)
        elementCount = elementCount + 1
        local dropdownOptions = options.Options or {}
        local default = options.Default or dropdownOptions[1]
        
        local dropFrame = Instance.new("Frame", Container)
        dropFrame.Size = UDim2.new(1,0,0,50)
        dropFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
        dropFrame.LayoutOrder = elementCount
        dropFrame.ClipsDescendants = true
        Instance.new("UICorner", dropFrame).CornerRadius = UDim.new(0,8)
        
        -- Title
        local title = Instance.new("TextLabel", dropFrame)
        title.Size = UDim2.new(1,-15,0,20)
        title.Position = UDim2.new(0,10,0,5)
        title.Text = options.Name or "Dropdown"
        title.TextColor3 = Color3.fromRGB(220,220,220)
        title.Font = Enum.Font.GothamSemibold
        title.TextSize = 12
        title.BackgroundTransparency = 1
        title.TextXAlignment = Enum.TextXAlignment.Left
        
        -- Select button
        local selectBtn = Instance.new("TextButton", dropFrame)
        selectBtn.Size = UDim2.new(1,-20,0,30)
        selectBtn.Position = UDim2.new(0,10,0,22)
        selectBtn.Text = "  " .. default .. "  ▼"
        selectBtn.TextColor3 = Color3.fromRGB(255,255,255)
        selectBtn.BackgroundColor3 = Color3.fromRGB(35,35,35)
        selectBtn.Font = Enum.Font.Gotham
        selectBtn.TextSize = 13
        selectBtn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", selectBtn).CornerRadius = UDim.new(0,6)
        
        -- Dropdown list
        local dropList = Instance.new("ScrollingFrame", dropFrame)
        dropList.Size = UDim2.new(1,-20,0,0)
        dropList.Position = UDim2.new(0,10,0,52)
        dropList.BackgroundColor3 = Color3.fromRGB(35,35,35)
        dropList.ScrollBarThickness = 4
        dropList.Visible = false
        dropList.CanvasSize = UDim2.new(0,0,0, #dropdownOptions * 32)
        dropList.BorderSizePixel = 0
        Instance.new("UICorner", dropList).CornerRadius = UDim.new(0,6)
        
        local listLayout = Instance.new("UIListLayout", dropList)
        listLayout.Padding = UDim.new(0,2)
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        
        local isOpen = false
        local selectedValue = default
        
        for i, opt in ipairs(dropdownOptions) do
            local optBtn = Instance.new("TextButton", dropList)
            optBtn.Size = UDim2.new(1,0,0,30)
            optBtn.Text = "  " .. opt
            optBtn.TextColor3 = Color3.fromRGB(200,200,200)
            optBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
            optBtn.Font = Enum.Font.Gotham
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.BackgroundTransparency = 0.5
            Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0,4)
            
            optBtn.MouseButton1Click:Connect(function()
                selectedValue = opt
                selectBtn.Text = "  " .. opt .. "  ▼"
                if options.Callback then options.Callback(opt) end
                
                isOpen = false
                TweenService:Create(dropList, TweenInfo.new(0.15), {Size = UDim2.new(1,-20,0,0)}):Play()
                TweenService:Create(dropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,50)}):Play()
                task.wait(0.15)
                dropList.Visible = false
                updateUISize()
            end)
            
            optBtn.MouseEnter:Connect(function()
                TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundTransparency = 0, BackgroundColor3 = ACCENT}):Play()
                optBtn.TextColor3 = Color3.fromRGB(255,255,255)
            end)
            
            optBtn.MouseLeave:Connect(function()
                TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundTransparency = 0.5, BackgroundColor3 = Color3.fromRGB(40,40,40)}):Play()
                optBtn.TextColor3 = Color3.fromRGB(200,200,200)
            end)
        end
        
        selectBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            if isOpen then
                dropList.Visible = true
                local height = math.min(#dropdownOptions * 34, 150)
                TweenService:Create(dropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,50 + height)}):Play()
                TweenService:Create(dropList, TweenInfo.new(0.15), {Size = UDim2.new(1,-20,0,height)}):Play()
                updateUISize()
            else
                TweenService:Create(dropList, TweenInfo.new(0.15), {Size = UDim2.new(1,-20,0,0)}):Play()
                TweenService:Create(dropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,50)}):Play()
                task.wait(0.15)
                dropList.Visible = false
                updateUISize()
            end
        end)
        
        updateUISize()
        
        return {
            SetValue = function(val)
                for _, opt in ipairs(dropdownOptions) do
                    if opt == val then
                        selectedValue = val
                        selectBtn.Text = "  " .. val .. "  ▼"
                        if options.Callback then options.Callback(val) end
                        break
                    end
                end
            end,
            GetValue = function() return selectedValue end
        }
    end

    -- ============================================
    -- REMADE COLOR PICKER
    -- ============================================
    function NoirUI:CreateColorPicker(options)
        elementCount = elementCount + 1
        local defaultColor = options.Default or Color3.fromRGB(170,85,255)
        
        local cpFrame = Instance.new("Frame", Container)
        cpFrame.Size = UDim2.new(1,0,0,50)
        cpFrame.BackgroundColor3 = Color3.fromRGB(25,25,25)
        cpFrame.LayoutOrder = elementCount
        cpFrame.ClipsDescendants = true
        Instance.new("UICorner", cpFrame).CornerRadius = UDim.new(0,8)
        
        -- Title
        local title = Instance.new("TextLabel", cpFrame)
        title.Size = UDim2.new(1,-70,0,20)
        title.Position = UDim2.new(0,10,0,5)
        title.Text = options.Name or "Color Picker"
        title.TextColor3 = Color3.fromRGB(220,220,220)
        title.Font = Enum.Font.GothamSemibold
        title.TextSize = 12
        title.BackgroundTransparency = 1
        title.TextXAlignment = Enum.TextXAlignment.Left
        
        -- Color preview
        local preview = Instance.new("TextButton", cpFrame)
        preview.Size = UDim2.new(0,40,0,30)
        preview.Position = UDim2.new(1,-50,0,22)
        preview.BackgroundColor3 = defaultColor
        preview.Text = ""
        Instance.new("UICorner", preview).CornerRadius = UDim.new(0,6)
        
        -- Hex display
        local hexText = Instance.new("TextLabel", cpFrame)
        hexText.Size = UDim2.new(0,70,0,20)
        hexText.Position = UDim2.new(1,-125,0,5)
        hexText.Text = "#" .. string.format("%02x%02x%02x", defaultColor.R*255, defaultColor.G*255, defaultColor.B*255)
        hexText.TextColor3 = ACCENT
        hexText.Font = Enum.Font.Gotham
        hexText.TextSize = 10
        hexText.BackgroundTransparency = 1
        
        -- Color panel
        local colorPanel = Instance.new("Frame", cpFrame)
        colorPanel.Size = UDim2.new(1,0,0,0)
        colorPanel.Position = UDim2.new(0,0,0,50)
        colorPanel.BackgroundColor3 = Color3.fromRGB(35,35,35)
        colorPanel.Visible = false
        colorPanel.ClipsDescendants = true
        Instance.new("UICorner", colorPanel).CornerRadius = UDim.new(0,0,0,8)
        
        -- Gradient palette
        local palette = Instance.new("ImageLabel", colorPanel)
        palette.Size = UDim2.new(1,-20,0,120)
        palette.Position = UDim2.new(0,10,0,10)
        palette.BackgroundColor3 = Color3.new(1,1,1)
        palette.Image = "rbxassetid://4155801252"
        Instance.new("UICorner", palette).CornerRadius = UDim.new(0,6)
        
        -- Palette picker
        local pickerDot = Instance.new("Frame", palette)
        pickerDot.Size = UDim2.new(0,12,0,12)
        pickerDot.BackgroundColor3 = Color3.new(1,1,1)
        pickerDot.BorderSizePixel = 0
        Instance.new("UICorner", pickerDot).CornerRadius = UDim.new(1,0)
        pickerDot.ZIndex = 2
        
        -- Hue slider
        local hueSlider = Instance.new("Frame", colorPanel)
        hueSlider.Size = UDim2.new(1,-20,0,16)
        hueSlider.Position = UDim2.new(0,10,0,140)
        hueSlider.BackgroundColor3 = Color3.fromRGB(255,255,255)
        Instance.new("UICorner", hueSlider).CornerRadius = UDim.new(1,0)
        
        local hueGradient = Instance.new("UIGradient", hueSlider)
        hueGradient.Rotation = 0
        hueGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0))
        }
        
        local hueDot = Instance.new("Frame", hueSlider)
        hueDot.Size = UDim2.new(0,12,0,20)
        hueDot.Position = UDim2.new(0,-6,0,-2)
        hueDot.BackgroundColor3 = Color3.new(1,1,1)
        hueDot.BorderSizePixel = 0
        Instance.new("UICorner", hueDot).CornerRadius = UDim.new(1,0)
        
        local currentH, currentS, currentV = defaultColor:ToHSV()
        
        local function updateColorDisplay()
            local finalColor = Color3.fromHSV(currentH, currentS, currentV)
            preview.BackgroundColor3 = finalColor
            palette.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
            
            pickerDot.Position = UDim2.new(currentS, -6, 1 - currentV, -6)
            hueDot.Position = UDim2.new(1 - currentH, -6, 0, -2)
            
            hexText.Text = "#" .. string.format("%02x%02x%02x", finalColor.R*255, finalColor.G*255, finalColor.B*255)
            
            if options.Callback then options.Callback(finalColor) end
        end
        
        -- Palette dragging
        local draggingPalette = false
        palette.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingPalette = true
                local function update()
                    local mousePos = UIS:GetMouseLocation()
                    local relativeX = math.clamp((mousePos.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
                    local relativeY = math.clamp((mousePos.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
                    currentS = relativeX
                    currentV = 1 - relativeY
                    updateColorDisplay()
                end
                
                local conn; conn = UIS.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement and draggingPalette then
                        update()
                    end
                end)
                
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingPalette = false
                        conn:Disconnect()
                    end
                end)
                update()
            end
        end)
        
        -- Hue dragging
        local draggingHue = false
        hueSlider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingHue = true
                local function update()
                    local mousePos = UIS:GetMouseLocation()
                    local relativeX = math.clamp((mousePos.X - hueSlider.AbsolutePosition.X) / hueSlider.AbsoluteSize.X, 0, 1)
                    currentH = 1 - relativeX
                    updateColorDisplay()
                end
                
                local conn; conn = UIS.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement and draggingHue then
                        update()
                    end
                end)
                
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingHue = false
                        conn:Disconnect()
                    end
                end)
                update()
            end
        end)
        
        local isOpen = false
        preview.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            colorPanel.Visible = true
            if isOpen then
                TweenService:Create(cpFrame, TweenInfo.new(0.25), {Size = UDim2.new(1,0,0,210)}):Play()
                TweenService:Create(colorPanel, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,160)}):Play()
            else
                TweenService:Create(colorPanel, TweenInfo.new(0.15), {Size = UDim2.new(1,0,0,0)}):Play()
                TweenService:Create(cpFrame, TweenInfo.new(0.2), {Size = UDim2.new(1,0,0,50)}):Play()
                task.wait(0.15)
                colorPanel.Visible = false
            end
            updateUISize()
        end)
        
        updateColorDisplay()
        updateUISize()
        
        return {
            SetColor = function(color)
                currentH, currentS, currentV = color:ToHSV()
                updateColorDisplay()
            end,
            GetColor = function()
                return Color3.fromHSV(currentH, currentS, currentV)
            end
        }
    end

    -- ============================================
    -- CÁC ELEMENT CŨ GIỮ NGUYÊN
    -- ============================================
    local elementCount = 0
    
    function NoirUI:CreateSection(text)
        elementCount = elementCount + 1
        local s = Instance.new("TextLabel", Container)
        s.Size = UDim2.new(1,0,0,30)
        s.Text = "— " .. text .. " —"
        s.TextColor3 = ACCENT
        s.Font = Enum.Font.GothamBold
        s.TextSize = 14
        s.BackgroundTransparency = 1
        s.LayoutOrder = elementCount
        updateUISize()
        return s
    end
    
    function NoirUI:CreateLabel(text)
        elementCount = elementCount + 1
        local l = Instance.new("TextLabel", Container)
        l.Size = UDim2.new(1,0,0,25)
        l.Text = text
        l.TextColor3 = Color3.fromRGB(220,220,220)
        l.Font = Enum.Font.Gotham
        l.TextSize = 13
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.LayoutOrder = elementCount
        Instance.new("UIPadding", l).PaddingLeft = UDim.new(0,8)
        updateUISize()
        return l
    end
    
    function NoirUI:CreateParagraph(text)
        elementCount = elementCount + 1
        local p = Instance.new("TextLabel", Container)
        p.Size = UDim2.new(1,0,0,0)
        p.AutomaticSize = Enum.AutomaticSize.Y
        p.Text = text
        p.TextColor3 = Color3.fromRGB(160,160,160)
        p.Font = Enum.Font.Gotham
        p.TextSize = 12
        p.BackgroundTransparency = 1
        p.TextWrapped = true
        p.TextXAlignment = Enum.TextXAlignment.Left
        p.LayoutOrder = elementCount
        Instance.new("UIPadding", p).PaddingLeft = UDim.new(0,8)
        Instance.new("UIPadding", p).PaddingRight = UDim.new(0,8)
        updateUISize()
        return p
    end
    
    function NoirUI:CreateButton(options)
        elementCount = elementCount + 1
        local b = Instance.new("TextButton", Container)
        b.Size = UDim2.new(1,0,0,38)
        b.Text = options.Name
        b.BackgroundColor3 = Color3.fromRGB(30,30,30)
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamSemibold
        b.TextSize = 14
        b.LayoutOrder = elementCount
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
        
        b.MouseButton1Click:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.08), {BackgroundColor3 = ACCENT}):Play()
            task.wait(0.08)
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30,30,30)}):Play()
            if options.Callback then options.Callback(b) end
        end)
        updateUISize()
        return b
    end
    
    function NoirUI:CreateToggle(options)
        elementCount = elementCount + 1
        local state = false
        local b = Instance.new("TextButton", Container)
        b.Size = UDim2.new(1,0,0,38)
        b.BackgroundColor3 = Color3.fromRGB(30,30,30)
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamSemibold
        b.TextSize = 14
        b.LayoutOrder = elementCount
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
        b.Text = options.Name .. ": OFF"
        
        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = options.Name .. ": " .. (state and "ON" or "OFF")
            TweenService:Create(b, TweenInfo.new(0.2), {
                BackgroundColor3 = state and ACCENT or Color3.fromRGB(30,30,30)
            }):Play()
            if options.Callback then options.Callback(state) end
        end)
        
        if options.Default then
            task.wait()
            b.MouseButton1Click:Fire()
        end
        updateUISize()
        return {SetValue = function(s) if s ~= state then b.MouseButton1Click:Fire() end end}
    end
    
    updateUISize()
    
    NoirUI:Notify(settings.Name or "Noir UI", "Loaded Successfully!", 3)
    
    return NoirUI
end

return NoirUI
